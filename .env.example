# Copy to .env.local for local development. On Vercel, set these per environment
# (Production -> production Supabase project, Preview -> staging Supabase project).

# local | staging | production (shown as a badge in the dashboard outside production)
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase -> Project Settings -> API Keys.
# The publishable key (sb_publishable_...) is safe in the browser; the legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. Server-only: bypasses row level security.
SUPABASE_SECRET_KEY=

# Encrypts WordPress application passwords before they are stored. 32 bytes, base64.
# Generate with `npm run gen:key`. Use a different key per environment and never change it
# without re-entering every website's application password.
CREDENTIALS_ENCRYPTION_KEY=

# Only for a WordPress site on plain http:// during local development. Requires APP_ENV=local.
ALLOW_INSECURE_WORDPRESS=false

# Protects /api/cron/*. Vercel sends it automatically to cron jobs once set in the project.
# Generate with `npm run gen:key`. Without it, the cron endpoints refuse every request.
CRON_SECRET=

# Server-only Gemini credentials. Model pricing must exist in Network settings before use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
